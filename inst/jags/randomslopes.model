model {
  for (i in 1:N) {
    log_cost[i] ~ dnorm(mu[i], tau)
    mu[i] <- alpha[country[i]] + inprod(x[i, ], beta[, country[i]])
  }

  for (j in 1:NC) {
		# non-centered paramaterisation
		alpha_raw[j] ~ dnorm(0, 1)
		alpha[j] <- mu_alpha + sigma_alpha * alpha_raw[j]
  }

	for (k in 1:K) {
    # hyper-parameter priors
    # uninformative prior for each mu_beta
    # mu_beta ~ Normal(0, 10^2)
    # PC prior for each sigma_beta assuming p(sigma_beta > 1) ~ 0.05
    # => lambda = -log(0.05)
    # sigma_beta ~ Exp(3)
    mu_beta[k] ~ dnorm(prior.beta.mean[k], prior.beta.precision[k])

    sigma_beta[k] ~ dexp(3)
    tau_beta[k] <- pow(sigma_beta[k], -2)

    for (j in 1:NC) {
      # country-level prior for beta[k]
      beta[k, j] ~ dnorm(mu_beta[k], tau_beta[k])
    }
  }

  mu_alpha ~ dnorm(prior.mu_alpha.mean, prior.mu_alpha.precision)
	sigma_alpha ~ dexp(prior.sigma_alpha.rate)

  sigma ~ dexp(prior.sigma.rate)
  tau <- pow(sigma, -2)
}
