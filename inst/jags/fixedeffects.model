model {
  for (i in 1:N) {
    log_cost[i] ~ dnorm(mu[i], tau)
    mu[i] <- alpha + inprod(x[i, ], beta[])
  }

  for (i in 1:N) {
    log_cost_pred[i] ~ dnorm(mu[i], tau)
    y_pred[i] <- exp(log_cost_pred[i])
  }

	alpha ~ dnorm(prior.mu_alpha.mean, prior.mu_alpha.precision)
	
	for (k in 1:K) {
		beta[k] ~ dnorm(prior.beta.mean[k], prior.beta.precision[k])
	}

  sigma ~ dexp(prior.sigma.rate)
  tau <- pow(sigma, -2)
}
